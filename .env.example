# Copy to .env (git-ignored). Values prefixed EXPO_PUBLIC_ are bundled into the app.
# Base URL of the Baytak API (must end with /api). Local: http://<your-LAN-ip>:7071/api
EXPO_PUBLIC_API_BASE_URL=https://<your-function-app>.azurewebsites.net/api
# Azure Functions host key sent as ?code=. Not a secret (it ships in the app): the JWT is what protects data.
EXPO_PUBLIC_API_KEY=
